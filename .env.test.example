# Dedicated, disposable PostgreSQL test service; never use application credentials here.
# Copy to .env.test for local changes. Keep the port in both values consistent.
AGENTFORGE_TEST_POSTGRES_PORT=55433
AGENTFORGE_TEST_DATABASE_URL=postgresql+psycopg://agentforge_test:agentforge_test_only@127.0.0.1:55433/agentforge_test?connect_timeout=5
