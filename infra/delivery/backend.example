AGENTFORGE_DATABASE_URL=
AGENTFORGE_WEB_ORIGIN=http://localhost:5173
AGENTFORGE_MODEL_PROVIDER=mock
# For real inference, set provider=chat_completions and fill these values.
AGENTFORGE_MODEL_BASE_URL=
AGENTFORGE_MODEL_NAME=
AGENTFORGE_MODEL_API_KEY=
# AGENTFORGE_MODEL_API_STYLE=deepseek
# AGENTFORGE_MCP_SERVERS_FILE=/etc/agentforge/mcp.json
# AGENTFORGE_MCP_COMPUTER_TOKEN=

# Enable original Web registration into isolated personal workspaces.
AGENTFORGE_REGISTRATION_ENABLED=false

# Optional public browser grants; see docs/visible-browser.md.
# AGENTFORGE_BROWSER_POLICY_FILE=/etc/agentforge/browser.json

# Anonymous web tools, independent of Computer; see docs/web-tools.md.
AGENTFORGE_WEB_ENABLED=false
AGENTFORGE_WEB_SEARCH_PROVIDER=duckduckgo
# Empty reuses BROWSER_POLICY_FILE; this separate file needs no browser token or desktop.
AGENTFORGE_WEB_POLICY_FILE=
AGENTFORGE_WEB_PROXY_URL=

# Personal model management: same random 32-byte base64 key on API and Worker only.
# Generate once, keep separately with backups; never commit the actual value.
# See docs/model-management.md. Empty disables saving personal credentials.
AGENTFORGE_MODEL_ENCRYPTION_KEY=
# Explicit internal model gateway origins, if needed; otherwise public HTTPS only.
AGENTFORGE_MODEL_ALLOWED_ORIGINS=[]

# Optional isolated Python/file generation. Explicit user grants; see docs/python-execution.md.
AGENTFORGE_PYTHON_POLICY_FILE=
AGENTFORGE_PYTHON_IMAGE=
AGENTFORGE_PYTHON_ENDPOINT=http://127.0.0.1:8766
# API/Worker and compute share AGENTFORGE_MCP_COMPUTER_TOKEN; never forward it to Computer/Web.
