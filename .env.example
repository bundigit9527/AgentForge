# macOS development: API/Worker on the host, PostgreSQL in Colima's Docker runtime.
# Copy to .env; pass --env-file .env to docker --context colima compose and uv run.
# Check with colima status; start manually with colima start --runtime docker if needed.
# The sample password is for this loopback-only development database, not production.
AGENTFORGE_POSTGRES_PORT=55432
AGENTFORGE_POSTGRES_PASSWORD=agentforge_local_dev_only
AGENTFORGE_DATABASE_URL=postgresql+psycopg://agentforge:agentforge_local_dev_only@127.0.0.1:55432/agentforge_dev?connect_timeout=10
# If changing the port/password, update AGENTFORGE_DATABASE_URL to match.
# URL-encode special characters in the password inside the URL.

# Offline unit tests always use temporary SQLite databases.
# Optional manual SQLite debugging:
# AGENTFORGE_DATABASE_URL=sqlite+pysqlite:///./agentforge-dev.db

# External PostgreSQL for a later environment; replace all placeholders:
# AGENTFORGE_DATABASE_URL=postgresql+psycopg://agentforge_user:URL_ENCODED_PASSWORD@db.example.internal:5432/agentforge?connect_timeout=10
# Set TLS parameters according to your database provider, for example:
# &sslmode=verify-full&sslrootcert=/path/to/root-ca.pem
# Application schema migrations remain explicit, never automatic.

# Authentication: development for local single-user debugging; database for local members/tokens.
# Configure API and Worker consistently. Bootstrap and token commands: docs/identity.md.
AGENTFORGE_AUTH_MODE=development
# Optional Rakazo browser login: database mode + exact public Web origin, no trailing slash.
# Keep empty to disable browser sessions. Use HTTPS outside loopback development.
# Example: http://127.0.0.1:5173; see docs/rakazo-orpc.md.
# Enable self-registration into a new personal workspace (database auth only).
AGENTFORGE_REGISTRATION_ENABLED=false
AGENTFORGE_WEB_ORIGIN=
# In development mode, leave the token empty to keep protected endpoints disabled.
# Set a random token of at least 32 characters before local manual API testing.
AGENTFORGE_DEV_TOKEN=
AGENTFORGE_DEV_TENANT=local
AGENTFORGE_DEV_SPACE=development
AGENTFORGE_DEV_USER=developer

# Model routing for API submission snapshots and Worker execution; default stays offline.
AGENTFORGE_MODEL_PROVIDER=mock
# To enable a compatible gateway, set provider=chat_completions and fill all three:
AGENTFORGE_MODEL_BASE_URL=
AGENTFORGE_MODEL_NAME=
AGENTFORGE_MODEL_API_KEY=
# Additional selectable model IDs on the SAME gateway, comma-separated. Default is always included.
AGENTFORGE_MODEL_ALLOWED_MODELS=
# openai: max_completion_tokens; deepseek: max_tokens + thinking disabled.
AGENTFORGE_MODEL_API_STYLE=openai
# DeepSeek V4 Pro: provider=chat_completions, api_style=deepseek,
# base_url=https://api.deepseek.com, model_name=deepseek-v4-pro (key in local .env only).
# Base URL example: https://your-gateway.example/v1 (no /chat/completions suffix).
# true enables upstream SSE; existing Agent/Run snapshots retain their original setting.
AGENTFORGE_MODEL_STREAM=false
AGENTFORGE_MODEL_TIMEOUT_SECONDS=30
AGENTFORGE_MODEL_MAX_ROUNDS=8
AGENTFORGE_MODEL_MAX_COMPLETION_TOKENS=2048
# New real-model snapshots: trim oldest complete history turns, or reject overflow.
# This is a character budget for messages + tool schemas, NOT a model token limit.
# Allowed range: 4000–200000. Existing snapshots retain their original policy/budget.
AGENTFORGE_MODEL_CONTEXT_POLICY=trim_history
AGENTFORGE_MODEL_CONTEXT_MAX_CHARS=100000

# API 和 Worker 使用一致的模型协议、地址及名称；API 不读取模型密钥。
# Run 提交时固定配置，后续修改默认模型不改变已提交的任务。

# Deployment-level tool allowlist; API and Worker should use the same value.
# Empty disables business tools. Bound skills retain the internal snapshot-only skill_read tool.
# External side-effect tools remain disabled.
AGENTFORGE_ALLOWED_TOOLS=example_report@1,text_stats@1

# Optional Skill Hub JSON adapter; API only, disabled when URL is blank.
# Fixed server-configured source; never supplied by a client or a model.
AGENTFORGE_SKILL_HUB_URL=
AGENTFORGE_SKILL_HUB_TOKEN=
AGENTFORGE_SKILL_HUB_TIMEOUT_SECONDS=10

# Optional remote MCP tools. Empty leaves MCP disabled; never auto-starts a server.
# Copy infra/mcp/servers.example.json to ignored mcp.local.json, then use an absolute path.
# API and Worker both need the same file and approved MCP credentials.
AGENTFORGE_MCP_SERVERS_FILE=
# Optional credential referenced by token_env in a real server configuration.
# The loopback demo uses token_env="" and does not need this token.
AGENTFORGE_MCP_PRODUCTS_TOKEN=

# Optional fixed-computation MCP service; also provision this token to Supervisor.
AGENTFORGE_MCP_COMPUTER_TOKEN=
